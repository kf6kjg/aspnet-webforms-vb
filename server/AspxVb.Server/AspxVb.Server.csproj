<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AspxVb.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Run on whatever .NET 10+ runtime the .NET Install Tool finds or acquires (ADR 0007). -->
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0" />
    <PackageReference Include="StreamJsonRpc" Version="2.26.150" />
    <!-- Reference-only package: its DLLs are copied to refs/ for the synthetic workspace,
         never referenced by this project (ADR 0002). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net461" Version="1.0.3"
                      ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net461)/build/.NETFramework/v4.6.1/**/*.dll;$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net461)/build/.NETFramework/v4.6.1/**/*.xml"
          Link="refs/net461/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
