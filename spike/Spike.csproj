<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0" />
    <!-- Only used as a source of .NET Framework 4.8 reference DLLs on disk; its
         build props would retarget a net48 build, so keep all assets out of ours. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3"
                      ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RefAssemblyDir"
                      Value="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)/build/.NETFramework/v4.8" />
    <AssemblyMetadata Include="SampleSiteDir"
                      Value="$(MSBuildProjectDirectory)/../samples/SampleSite" />
  </ItemGroup>

</Project>
