{
  "name": "aspnet-webforms-vb",
  "displayName": "ASP.NET Web Forms (VB) for Web Site projects",
  "description": "Highlighting, snippets, navigation, completion and error checking for legacy ASP.NET Web Forms Web Site projects in VB.NET (.aspx, .ascx, .master, code-behind).",
  "version": "0.12.0",
  "publisher": "kf6kjg",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kf6kjg/aspnet-webforms-vb.git"
  },
  "bugs": {
    "url": "https://github.com/kf6kjg/aspnet-webforms-vb/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aspx-vb",
        "aliases": [
          "ASP.NET Web Forms (VB)",
          "aspx"
        ],
        "extensions": [
          ".aspx",
          ".ascx",
          ".master"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aspx-vb",
        "scopeName": "text.html.aspx",
        "path": "./syntaxes/aspx.tmLanguage.json",
        "embeddedLanguages": {
          "source.vb.embedded.aspx": "vb",
          "source.css": "css",
          "source.js": "javascript"
        }
      },
      {
        "scopeName": "source.vb.sql-injection",
        "path": "./syntaxes/vb-sql.injection.tmLanguage.json",
        "injectTo": [
          "source.asp.vb.net"
        ]
      },
      {
        "scopeName": "source.vb.web-injection",
        "path": "./syntaxes/vb-web.injection.tmLanguage.json",
        "injectTo": [
          "source.asp.vb.net"
        ]
      }
    ],
    "snippets": [
      {
        "language": "aspx-vb",
        "path": "./snippets/aspx.code-snippets"
      },
      {
        "language": "vb",
        "path": "./snippets/vb-webforms.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "aspxVb.viewCode",
        "title": "View Code",
        "category": "ASP.NET"
      },
      {
        "command": "aspxVb.viewMarkup",
        "title": "View Markup",
        "category": "ASP.NET"
      }
    ],
    "keybindings": [
      {
        "command": "aspxVb.viewCode",
        "key": "f7",
        "when": "editorTextFocus && editorLangId == aspx-vb"
      },
      {
        "command": "aspxVb.viewMarkup",
        "key": "shift+f7",
        "when": "editorTextFocus && resourceFilename =~ /\\.(aspx|ascx|master)\\.vb$/i"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aspxVb.viewCode",
          "when": "editorLangId == aspx-vb",
          "group": "navigation@90"
        },
        {
          "command": "aspxVb.viewMarkup",
          "when": "resourceFilename =~ /\\.(aspx|ascx|master)\\.vb$/i",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "aspxVb.viewCode",
          "when": "editorLangId == aspx-vb"
        },
        {
          "command": "aspxVb.viewMarkup",
          "when": "resourceFilename =~ /\\.(aspx|ascx|master)\\.vb$/i"
        }
      ]
    },
    "configuration": {
      "title": "ASP.NET Web Forms (VB)",
      "properties": {
        "aspxVb.diagnostics.missingFiles": {
          "type": "boolean",
          "default": true,
          "description": "Warn about href, src, ImageUrl and similar references, and paths in VB strings such as Response.Redirect(\"…\"), to files that don't exist in the site, or whose case differs from the file on disk."
        },
        "aspxVb.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the language server: a .dll (run with a .NET runtime from the .NET Install Tool) or an executable. Empty uses the one shipped with the extension."
        },
        "aspxVb.assemblyFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders to search for assemblies a site's `web.config` lists that are in neither its `Bin` nor the .NET Framework, typically ones the web server loads from its GAC, such as `MySql.Data`. `~` means your home folder. See MISSING-ASSEMBLIES.md in the extension."
        }
      }
    },
    "configurationDefaults": {
      "[vb]": {
        "editor.formatOnType": true,
        "editor.tabSize": 1,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      },
      "[aspx-vb]": {
        "editor.tabSize": 1,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\" && vscode-tmgrammar-test -g syntaxes/aspx.tmLanguage.json -g test/vendor-grammars/html.tmLanguage.json -g test/vendor-grammars/html-derivative.tmLanguage.json -g test/vendor-grammars/asp-vb-net.tmLanguage.json -g test/vendor-grammars/JavaScript.tmLanguage.json -g test/vendor-grammars/css.tmLanguage.json \"test/grammar/**/*.test.*\" && node test/check-manifest.mjs",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist/"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^1.7.0",
    "vscode-textmate": "^7.0.4",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:vb"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "extensionDependencies": [
    "ms-dotnettools.vscode-dotnet-runtime"
  ]
}
