# .NET build output (server). Anchored so samples/**/Bin is never ignored.
/server/**/bin/
/server/**/obj/

# Extension build output
/extension/node_modules/
/extension/out/
/extension/dist/

# Machine-specific mise settings
mise.local.toml

# Site scan output: contains the developer's site names, paths and DLL names
/.scan/

# Language server published into the extension by `mise run server:build`
/extension/server/
